{"label":"Markdown in Zacess Deep Contrast Dark","background":"#000000","foreground":"#ffffff","lines":[[["#","#ffffff",0],[" Week 4: signals","#67aeff",1]],[],[["Lecture notes, imported from the slides and checked by hand.","#ffffff",0]],[],[["##","#ffffff",0],[" Key ideas","#67aeff",1]],[],[["- A **","#ffffff",0],["low pass","#ffffff",1],["** filter keeps the slow parts of a signal.","#ffffff",0]],[["- The *","#ffffff",0],["cut-off frequency","#ffffff",2],["* is where the output falls to 70.7% of the input.","#ffffff",0]],[["- Each extra order adds 20 dB per decade of roll-off.","#ffffff",0]],[],[[">","#ffffff",0],[" [","#ffffff",0],["!NOTE","#ffdf5a",4],["]","#ffffff",0]],[[">","#ffffff",0],[" The number on slide 12 was misread by OCR and corrected here.","#00c600",2]],[],[["| Order | Roll-off |","#ffffff",0]],[["| --- | --- |","#ffffff",0]],[["| 1 | 20 dB per decade |","#ffffff",0]],[["| 2 | 40 dB per decade |","#ffffff",0]],[],[["```python","#ffffff",0]],[["cutoff = ","#ffffff",0],["1","#e19e00",0],[" / (","#ffffff",0],["2","#e19e00",0],[" * pi * r * c)","#ffffff",0]],[["```","#ffffff",0]],[],[["See [","#ffffff",0],["the full handout","#ffdf5a",4],["](","#ffffff",0],["handout.pdf","#ffdf5a",4],[") for the derivation.","#ffffff",0]]]}
