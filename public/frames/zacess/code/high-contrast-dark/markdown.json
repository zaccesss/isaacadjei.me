{"label":"Markdown in Zacess High Contrast Dark","background":"#000000","foreground":"#ffffff","lines":[[["#","#ffffff",0],[" Week 4: signals","#f5c400",1]],[],[["Lecture notes, imported from the slides and checked by hand.","#ffffff",0]],[],[["##","#ffffff",0],[" Key ideas","#f5c400",1]],[],[["- A **","#ffffff",0],["low pass","#ffffff",1],["** filter keeps the slow parts of a signal.","#ffffff",0]],[["- The *","#ffffff",0],["cut-off frequency","#ffffff",2],["* is where the output falls to 70.7% of the input.","#ffffff",0]],[["- Each extra order adds 20 dB per decade of roll-off.","#ffffff",0]],[],[[">","#ffffff",0],[" [","#ffffff",0],["!NOTE","#8fd0ff",4],["]","#ffffff",0]],[[">","#ffffff",0],[" The number on slide 12 was misread by OCR and corrected here.","#c7b404",2]],[],[["| Order | Roll-off |","#ffffff",0]],[["| --- | --- |","#ffffff",0]],[["| 1 | 20 dB per decade |","#ffffff",0]],[["| 2 | 40 dB per decade |","#ffffff",0]],[],[["```python","#ffffff",0]],[["cutoff = ","#ffffff",0],["1","#ffb27a",0],[" / (","#ffffff",0],["2","#ffb27a",0],[" * pi * r * c)","#ffffff",0]],[["```","#ffffff",0]],[],[["See [","#ffffff",0],["the full handout","#8fd0ff",4],["](","#ffffff",0],["handout.pdf","#8fd0ff",4],[") for the derivation.","#ffffff",0]]]}
