{"label":"Markdown in Zacess High Contrast Light","background":"#ffffff","foreground":"#000000","lines":[[["#","#000000",0],[" Week 4: signals","#4b0091",1]],[],[["Lecture notes, imported from the slides and checked by hand.","#000000",0]],[],[["##","#000000",0],[" Key ideas","#4b0091",1]],[],[["- A **","#000000",0],["low pass","#000000",1],["** filter keeps the slow parts of a signal.","#000000",0]],[["- The *","#000000",0],["cut-off frequency","#000000",2],["* is where the output falls to 70.7% of the input.","#000000",0]],[["- Each extra order adds 20 dB per decade of roll-off.","#000000",0]],[],[[">","#000000",0],[" [","#000000",0],["!NOTE","#00347f",4],["]","#000000",0]],[[">","#000000",0],[" The number on slide 12 was misread by OCR and corrected here.","#1701fb",2]],[],[["| Order | Roll-off |","#000000",0]],[["| --- | --- |","#000000",0]],[["| 1 | 20 dB per decade |","#000000",0]],[["| 2 | 40 dB per decade |","#000000",0]],[],[["```python","#000000",0]],[["cutoff = ","#000000",0],["1","#521e00",0],[" / (","#000000",0],["2","#521e00",0],[" * pi * r * c)","#000000",0]],[["```","#000000",0]],[],[["See [","#000000",0],["the full handout","#00347f",4],["](","#000000",0],["handout.pdf","#00347f",4],[") for the derivation.","#000000",0]]]}
